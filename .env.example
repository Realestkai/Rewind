# Discord application bot token. Keep this secret.
DISCORD_BOT_TOKEN=

# Server and channel/role IDs used by the ticket workflow.
DISCORD_GUILD_ID=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_STAFF_ROLE_ID=

# Optional: a second role that can view and work every ticket.
DISCORD_OWNER_ROLE_ID=

# Optional: react to every image attachment posted in this channel.
DISCORD_SHOWROOM_CHANNEL_ID=
DISCORD_SHOWROOM_REACTION=🔥

# Optional persistent file path. On Railway, point this inside a mounted Volume.
TICKET_DATA_PATH=./data/tickets.json
